# Docker Compose project name (optional).
COMPOSE_PROJECT_NAME=simpleminingproxy

# Admin UI credentials. Set a long, unique password before starting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional Bearer token for API clients. Leave empty to disable token auth.
API_TOKEN=

# Public address shown in ASIC connection hints in the admin UI.
PUBLIC_HOST=proxy.example.com
PUBLIC_TCP_PORT=13333
PUBLIC_TLS_PORT=14443

# DNS names and/or IP addresses for an automatically generated certificate.
# This is used only when /data/certs/fullchain.pem and privkey.pem do not exist.
TLS_SELF_SIGNED_HOSTS=proxy.example.com,203.0.113.10

# Admin is published on 127.0.0.1 only. Reach it through an SSH tunnel.
ADMIN_PORT=18080

# json or text
LOG_FORMAT=json

# Telegram bot token from @BotFather. Keep it here, never in the repository:
# a token set through the environment cannot be read or changed from the
# browser. Chats and language are set in the admin UI (Settings).
TELEGRAM_BOT_TOKEN=

# Only if api.telegram.org is blocked where the proxy runs, point it elsewhere:
# TELEGRAM_API_URL=https://api.telegram.org
